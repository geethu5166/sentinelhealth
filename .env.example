# SentinelHealth Environment Configuration
# Copy to .env and customize. NEVER commit .env to source control.

# ── Database Roles (Separation of Migration Owner vs Restricted App User) ──
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME_sentinel_dev_2024
POSTGRES_DB=sentinelhealth
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Dedicated Migration Schema Owner (Runs DDL & Alembic migrations)
MIGRATOR_DB_USER=sentinel_migrator
MIGRATOR_DB_PASSWORD=CHANGE_ME_migrator_pass_2024
SENTINEL_MIGRATION_DATABASE_URL=postgresql+psycopg://sentinel_migrator:CHANGE_ME_migrator_pass_2024@postgres:5432/sentinelhealth

# Restricted Application Runtime User (DML only, NOBYPASSRLS, subject to RLS)
APP_DB_USER=sentinel_app
APP_DB_PASSWORD=CHANGE_ME_app_pass_2024
SENTINEL_DATABASE_URL=postgresql+asyncpg://sentinel_app:CHANGE_ME_app_pass_2024@postgres:5432/sentinelhealth

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
SENTINEL_REDIS_URL=redis://redis:6379/0

# ── Keycloak ──
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_2024
SENTINEL_KEYCLOAK_URL=http://keycloak:8080
SENTINEL_KEYCLOAK_REALM=sentinelhealth
SENTINEL_KEYCLOAK_CLIENT_ID=sentinel-frontend
SENTINEL_KEYCLOAK_AUDIENCE=sentinel-api

# ── Application ──
SENTINEL_SECRET_KEY=CHANGE_ME_random_secret_key_at_least_32_chars
SENTINEL_CORS_ORIGINS=["http://localhost:8080"]
SENTINEL_DEBUG=true
SENTINEL_LOG_LEVEL=INFO
SENTINEL_DEMO_MODE=true
SENTINEL_DEFAULT_TIMEZONE=Asia/Kolkata

# ── Privacy defaults ──
SENTINEL_PRIVACY_MIN_CONTRIBUTORS=10
SENTINEL_PRIVACY_SUPPRESS_RANGE_MIN=1
SENTINEL_PRIVACY_SUPPRESS_RANGE_MAX=4

# ── Mailpit (local email testing) ──
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
